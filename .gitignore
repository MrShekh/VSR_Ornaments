# Dependencies
/node_modules/
/.pnp
.pnp.*
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/versions

# Next.js build output
/.next/
/out/

# Production builds and test coverage
/build/
/dist/
/coverage/

# Environment files — keep secrets out of Git
.env
.env.*
!.env.example

# Deployment providers
/.vercel/
/.netlify/

# TypeScript and tooling caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.stylelintcache
.turbo/
.cache/

# Package-manager and application logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local editor settings
/.idea/
/.vscode/
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Certificates and private keys
*.pem
*.key

# Temporary files
*.tmp
*.temp
~$*
